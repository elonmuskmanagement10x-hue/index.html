/* ---------- Candlestick chart (Binance live klines) ---------- */
function drawCandles(candles){
  var cv=$("#btcChart");if(!cv)return;var ctx=cv.getContext("2d");
  var W=cv.width,H=cv.height;ctx.clearRect(0,0,W,H);
  var min=Infinity,max=-Infinity;
  candles.forEach(function(k){min=Math.min(min,k[3]);max=Math.max(max,k[2])});
  var pad=(max-min)*0.08||1;min-=pad;max+=pad;
  function Y(v){return H-((v-min)/(max-min))*H}
  var step=W/candles.length,bw=Math.max(4,step*0.55);
  candles.forEach(function(k,i){
    var o=+k[1],h=+k[2],l=+k[3],c=+k[4];var up=c>=o;var col=up?"#10b981":"#fb4d6d";
    var x=i*step+step/2;ctx.strokeStyle=col;ctx.fillStyle=col;ctx.lineWidth=1.4;
    ctx.beginPath();ctx.moveTo(x,Y(h));ctx.lineTo(x,Y(l));ctx.stroke();
    var y1=Y(Math.max(o,c)),y2=Y(Math.min(o,c));ctx.fillRect(x-bw/2,y1,bw,Math.max(2,y2-y1));
  });
}
function fetchChart(){
  fetch("https://api.binance.com/api/v3/klines?symbol=BTCUSDT&interval=1m&limit=30")
    .then(function(r){if(!r.ok)throw new Error("chart");return r.json()})
    .then(function(rows){drawCandles(rows);var last=rows[rows.length-1];if(last)$("#chartPrice").textContent="$"+fmtPrice(+last[4])})
    .catch(function(){
      fetch("https://api.coingecko.com/api/v3/coins/bitcoin/ohlc?vs_currency=usd&days=1")
        .then(function(r){if(!r.ok)throw new Error("ohlc");return r.json()})
        .then(function(rows){var slim=rows.slice(-30).map(function(x){return [x[0],x[1],x[2],x[3],x[4]]});drawCandles(slim)})
        .catch(function(){$("#chartNote").textContent="The live chart feed is unreachable right now. Prices above and in the Markets table still refresh from CoinGecko every 60 seconds."});
    });
}
fetchChart();setInterval(fetchChart,60000);

