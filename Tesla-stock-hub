  if(!currentUser()){showView("login");return}
  showView("dash");
  $$(".dash-nav button").forEach(function(b){b.classList.toggle("active",b.getAttribute("data-dtab")===name)});
  $$(".dpanel").forEach(function(p){p.style.display=p.id==="dp-"+name?"block":"none"});
  window.scrollTo(0,0);
}
$$("[data-dtab]").forEach(function(b){b.addEventListener("click",function(){openTab(b.getAttribute("data-dtab"))})});

/* ---------- Money actions (session records) ---------- */
function nowStr(){return new Date().toLocaleString()}
$("#depForm").addEventListener("submit",function(e){
  e.preventDefault();var u=currentUser();if(!u)return;showErr("#depErr","");showOk("#depOk","");
  var amt=parseFloat($("#depAmt").value);
  if(!amt||amt<10)return showErr("#depErr","Enter an amount of at least $10.");
  u.txs.push({type:"Deposit",method:$("#depMethod").value,amount:amt,status:"Pending",date:nowStr()});
  u.notifs.push({text:"Deposit request of "+fmt$(amt)+" via "+$("#depMethod").value+" received and pending confirmation.",time:nowStr(),read:false});
  renderDash();showOk("#depOk","Deposit request recorded as Pending. Message Support from this dashboard and the team will send the payment details for "+$("#depMethod").value+". Your balance updates once payment is confirmed.");
});
$("#wdForm").addEventListener("submit",function(e){
  e.preventDefault();var u=currentUser();if(!u)return;showErr("#wdErr","");showOk("#wdOk","");
  var amt=parseFloat($("#wdAmt").value);
  if(!amt||amt<10)return showErr("#wdErr","Enter an amount of at least $10.");
  if(!$("#wdDest").value.trim())return showErr("#wdErr","Enter the destination for this withdrawal.");
  if(amt>u.balance)return showErr("#wdErr","Amount is more than your available balance of "+fmt$(u.balance)+".");
  u.balance-=amt;u.held+=amt;
  u.txs.push({type:"Withdrawal",method:$("#wdMethod").value,amount:amt,status:"Pending",date:nowStr()});
  u.notifs.push({text:"Withdrawal request of "+fmt$(amt)+" via "+$("#wdMethod").value+" is pending review. The amount is held while pending.",time:nowStr(),read:false});
  renderDash();showOk("#wdOk","Withdrawal request recorded as Pending and held from your available balance for review.");
});
$("#stakeForm").addEventListener("submit",function(e){
  e.preventDefault();var u=currentUser();if(!u)return;showErr("#stkErr","");showOk("#stkOk","");
  var parts=$("#stkAsset").value.split("|");var amt=parseFloat($("#stkAmt").value);
  if(!amt||amt<10)return showErr("#stkErr","Enter an amount of at least $10.");
  if(amt>u.balance)return showErr("#stkErr","You need available balance to stake. Your available balance is "+fmt$(u.balance)+" — deposit first, wait for confirmation, then stake.");
  u.balance-=amt;u.staked+=amt;u.stakes.push({asset:parts[0],apy:parts[1],amount:amt,date:nowStr()});
  renderDash();showOk("#stkOk","Staking started: "+fmt$(amt)+" in "+parts[0]+" at "+parts[1]+"% APY (variable, not guaranteed).");
});
$("#markReadBtn").addEventListener("click",function(){var u=currentUser();if(!u)return;u.notifs.forEach(function(n){n.read=true});renderDash()});

/* ---------- Settings / API base ---------- */
$("#setForm").addEventListener("submit",function(e){
  e.preventDefault();var u=currentUser();if(!u)return;
  u.name=$("#setName").value.trim()||u.name;u.phone=$("#setPhone").value.trim();u.country=$("#setCountry").value.trim();u.currency=$("#setCurrency").value;
  var pw=$("#setPw").value;if(pw){if(pw.length<8){toast("New password must be at least 8 characters.");return}u.password=pw;$("#setPw").value=""}
  renderDash();showOk("#setOk","Settings saved.");setTimeout(function(){showOk("#setOk","")},3000);
});
$("#apiSaveBtn").addEventListener("click",function(){
  DataLayer.apiBase=$("#apiBase").value.trim();DataLayer.mode=DataLayer.apiBase?"hosted":"session";
  showOk("#apiOk",DataLayer.apiBase?("API base saved for this session: "+DataLayer.apiBase+". Endpoints go live once the shared backend is deployed at that address."):"API base cleared — running in standalone session mode.");
});

/* ---------- Sync code (TS1.) ---------- */
function encodeUser(u){return "TS1."+btoa(unescape(encodeURIComponent(JSON.stringify(u))))}
function download(name,text){var a=document.createElement("a");a.href="data:text/plain;charset=utf-8,"+encodeURIComponent(text);a.download=name;document.body.appendChild(a);a.click();document.body.removeChild(a)}
$("#exportBtn").addEventListener("click",function(){var u=currentUser();if(!u)return;download("tesla-stock-sync-"+u.username+".txt",encodeUser(u));toast("Sync code downloaded.")});
$("#copyCodeBtn").addEventListener("click",function(){var u=currentUser();if(!u)return;var code=encodeUser(u);if(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText(code).then(function(){toast("Sync code copied.")},function(){toast("Copy failed — use Download instead.")})}else toast("Copy isn't available here — use Download instead.")});
$("#importBtn").addEventListener("click",function(){
  showErr("#syncErr","");showOk("#syncOk","");
  var raw=$("#importCode").value.trim();
  if(raw.indexOf("TS1.")!==0)return showErr("#syncErr","That doesn't look like a TS1. sync code.");
  try{
    var u=JSON.parse(decodeURIComponent(escape(atob(raw.slice(4)))));
    if(!u.email||!u.username)throw new Error("bad");
    var existing=findUser(u.email);
    if(existing){var i=DB.users.indexOf(existing);DB.users[i]=u}else DB.users.push(u);
    DB.session=u;syncHeader();renderDash();showOk("#syncOk","Account restored from sync code. You're logged in as "+u.username+".");
  }catch(err){showErr("#syncErr","That sync code couldn't be read. Check it was copied in full and try again.")}
});

/* ---------- Support chat ---------- */
function sendSupport(text){
  text=String(text||"").trim();if(!text)return;
  var u=currentUser();
  if(u){u.support.push({from:"me",text:text});renderDash()}
  else{$("#chatMsgs").innerHTML+='<div class="msg me">'+text.replace(/</g,"&lt;")+'</div>'}
  setTimeout(function(){
    var reply="Thanks — your message has been received. A support agent will reply here. For anything urgent about a pending deposit or withdrawal, include the amount and method in your message.";
    if(u){u.support.push({from:"them",text:reply});u.notifs.push({text:"Support replied to your message.",time:nowStr(),read:false});renderDash()}
    else{$("#chatMsgs").innerHTML+='<div class="msg them">'+reply+'</div>';$("#chatMsgs").scrollTop=1e6}
  },700);
}
$("#chatForm").addEventListener("submit",function(e){e.preventDefault();var v=$("#chatInput").value;$("#chatInput").value="";sendSupport(v)});
$("#supportForm").addEventListener("submit",function(e){e.preventDefault();var v=$("#supportInput").value;$("#supportInput").value="";sendSupport(v)});
$("#chatFab").addEventListener("click",function(){$("#chatPanel").classList.toggle("open");renderSupport()});
$("#chatClose").addEventListener("click",function(){$("#chatPanel").classList.remove("open")});
$("#contactChat").addEventListener("click",function(e){e.preventDefault();$("#chatPanel").classList.add("open");renderSupport()});

/* language selector (label only in this build) */
var langs=[["EN","🇺🇸"],["ES","🇪🇸"],["FR","🇫🇷"],["DE","🇩🇪"]];var langIdx=0;
$("#langBtn").addEventListener("click",function(){langIdx=(langIdx+1)%langs.length;this.textContent=langs[langIdx][1]+" "+langs[langIdx][0]+" ⌃";if(langs[langIdx][0]!=="EN")toast("Interface language stays in English in this build — full translations arrive with the hosted release.")});

syncHeader();renderSupport();
})();
</script>
</body>
</html>
