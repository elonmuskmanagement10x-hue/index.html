function renderPrices(){
  var tb=$("#marketBody");
  if(tb){tb.innerHTML=COINS.map(function(c){var p=PRICES[c.id];return "<tr><td class='sym'>"+c.sym+"</td><td>"+(p?fmtPrice(p.price):"…")+"</td><td>"+(p?chgHtml(p.chg):"…")+"</td></tr>"}).join("")}
