  if(ag){ag.innerHTML=COINS.map(function(c){var p=PRICES[c.id];return '<div class="asset-card"><div class="coin-ic" style="color:'+c.color+'">'+c.ini+'</div><h3>'+c.name+'</h3><div class="sym">'+c.sym+'</div><div class="price">$'+(p?fmtPrice(p.price):"…")+'</div><div class="chg">'+(p?chgHtml(p.chg):"")+'</div><div class="bar"></div></div>'}).join("")}
  var items=COINS.map(function(c){var p=PRICES[c.id];if(!p)return "";return '<span class="tick-item"><b>'+c.sym+'</b> $'+fmtPrice(p.price)+' '+(p.chg>=0?'<span class="up">▲ '+Math.abs(p.chg).toFixed(2)+'%</span>':'<span class="down">▼ '+Math.abs(p.chg).toFixed(2)+'%</span>')+'</span>'}).join("");
  if(items)$("#tickerTrack").innerHTML=items+items;
  $$("[data-price]").forEach(function(el){var p=PRICES[el.getAttribute("data-price")];el.textContent=p?"$"+fmtPrice(p.price):"—"});
