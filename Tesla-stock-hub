/* ---------- Live prices (CoinGecko) ---------- */
var COINS=[
 {id:"bitcoin",name:"Bitcoin",sym:"BTCUSD",short:"BTC",ini:"BT",color:"#f7931a"},
 {id:"ethereum",name:"Ethereum",sym:"ETHUSD",short:"ETH",ini:"ET",color:"#627eea"},
