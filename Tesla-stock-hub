/* counters */
function animateCount(el){
  var to=parseFloat(el.getAttribute("data-to")),dec=parseInt(el.getAttribute("data-dec")||"0",10),suf=el.getAttribute("data-suffix")||"";
  var start=null,dur=1600;
  function step(ts){if(!start)start=ts;var p=Math.min(1,(ts-start)/dur);var v=to*p;el.textContent=v.toLocaleString("en-US",{minimumFractionDigits:dec,maximumFractionDigits:dec})+suf;if(p<1)requestAnimationFrame(step)}
  requestAnimationFrame(step);
}
